{
  "name": "peernotes-studentnotes",
  "version": "1.0.0",
  "description": "PeerNotes – Student Notes & Academic Resource Marketplace",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm start",
    "server:dev": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "seed": "cd server && node seed.js",
    "test": "cd server && node test_flow.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "peernotes",
    "student-notes",
    "education",
    "resource-marketplace",
    "fullstack",
    "react",
    "node",
    "express",
    "mongodb"
  ],
  "author": "PeerNotes Development Team",
  "license": "ISC"
}
